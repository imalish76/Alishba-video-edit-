
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome Baby Fatima Tuz Zahra 🎀</title>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Great+Vibes&family=Playfair+Display:wght@400;600;700&family=Poppins:wght@300;400;500;600&display=swap');

    :root {
      --pink: #f7a8c4;
      --dark-pink: #b85b83;
      --cream: #fff9f5;
      --text: #653e51;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Poppins', sans-serif;
      color: var(--text);
      background: #fff2f7;
      overflow-x: hidden;
    }

    .page {
      min-height: 100vh;
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at 15% 15%, #ffe2ed 0, transparent 30%),
        radial-gradient(circle at 90% 80%, #f8d5e5 0, transparent 35%),
        linear-gradient(145deg, #fff9fb, #ffeaf3);
    }

    .sparkle {
      position: absolute;
      color: #e6a1bd;
      font-size: 20px;
      animation: twinkle 3s ease-in-out infinite;
      pointer-events: none;
    }

    .sparkle:nth-child(1) { top: 9%; left: 9%; }
    .sparkle:nth-child(2) { top: 22%; right: 12%; animation-delay: 1s; }
    .sparkle:nth-child(3) { top: 65%; left: 5%; animation-delay: 2s; }
    .sparkle:nth-child(4) { top: 82%; right: 8%; animation-delay: .5s; }

    .balloon {
      position: absolute;
      width: 65px;
      height: 80px;
      border-radius: 50% 50% 45% 45%;
      background: #f5a5c2;
      opacity: .65;
      animation: float 6s ease-in-out infinite;
    }

    .balloon::after {
      content: '';
      position: absolute;
      width: 1px;
      height: 90px;
      background: #d78ba9;
      top: 78px;
      left: 50%;
    }

    .balloon.one { top: 10%; left: -20px; }
    .balloon.two { top: 16%; right: -20px; background: #e9b8f0; animation-delay: 1s; }
    .balloon.three { bottom: 10%; left: -25px; background: #f7c6d6; animation-delay: 2s; }

    .content {
      width: 100%;
      max-width: 900px;
      margin: auto;
      padding: 42px 20px 60px;
      text-align: center;
      position: relative;
      z-index: 1;
    }

    .tag {
      display: inline-block;
      color: #b35c80;
      background: rgba(255,255,255,.7);
      border: 1px solid #f2c4d5;
      padding: 8px 18px;
      border-radius: 30px;
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 22px;
    }

    h1 {
      font-family: 'Great Vibes', cursive;
      font-size: clamp(45px, 9vw, 85px);
      line-height: 1.15;
      font-weight: 400;
      color: #bc6389;
      margin-bottom: 15px;
    }

    .subtitle {
      font-family: 'Playfair Display', serif;
      font-size: clamp(17px, 3vw, 23px);
      color: #8c526c;
      margin-bottom: 35px;
    }

    .baby-card {
      max-width: 500px;
      margin: 0 auto 35px;
      background: rgba(255,255,255,.76);
      padding: 15px;
      border: 1px solid rgba(255,255,255,.9);
      border-radius: 28px;
      box-shadow: 0 15px 45px rgba(182,92,130,.10);
    }

    .photo {
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: 20px;
      overflow: hidden;
      background: linear-gradient(145deg, #ffe4ee, #f9c8dc);
      position: relative;
    }

    .photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: none;
    }

    .photo.has-image img {
      display: block;
    }

    .photo.has-image .placeholder {
      display: none;
    }

    .placeholder {
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: #b86a8c;
    }

    .placeholder .icon {
      font-size: 65px;
      animation: heartbeat 3s ease-in-out infinite;
    }

    .placeholder p {
      font-size: 13px;
      opacity: .8;
    }

    .photo-label {
      margin-top: 13px;
      font-family: 'Playfair Display', serif;
      font-size: 18px;
      color: #a55a7b;
    }

    .date {
      font-size: 12px;
      color: #b77b96;
      margin-top: 5px;
    }

    .welcome {
      max-width: 560px;
      margin: auto;
      padding: 30px 25px;
      background: rgba(255,255,255,.65);
      border: 1px solid #f4cddd;
      border-radius: 25px;
      box-shadow: 0 12px 40px rgba(186,94,133,.07);
    }

    .welcome h2 {
      font-family: 'Playfair Display', serif;
      font-weight: 600;
      font-size: 25px;
      color: #a55378;
      margin-bottom: 17px;
    }

    .welcome p {
      font-family: 'Playfair Display', serif;
      font-size: 19px;
      line-height: 1.9;
      font-style: italic;
      color: #75495d;
    }

    .divider {
      color: #e8a4be;
      font-size: 20px;
      margin: 23px 0;
      letter-spacing: 7px;
    }

    .button {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      border: none;
      background: #c96d96;
      color: white;
      font: 500 14px 'Poppins', sans-serif;
      padding: 14px 25px;
      border-radius: 30px;
      cursor: pointer;
      margin-top: 28px;
      box-shadow: 0 7px 20px rgba(201,109,150,.2);
      transition: transform .2s, background .2s;
    }

    .button:active {
      transform: scale(.96);
    }

    .button:hover {
      background: #b75c85;
    }

    .surprise {
      display: none;
      margin-top: 25px;
      padding: 25px 20px;
      border-radius: 20px;
      background: #fff0f6;
      border: 1px solid #f6c5d9;
      animation: appear .7s ease both;
    }

    .surprise.show {
      display: block;
    }

    .surprise h3 {
      color: #b45e83;
      font-family: 'Great Vibes', cursive;
      font-size: 38px;
      font-weight: 400;
      margin-bottom: 10px;
    }

    .surprise p {
      font-size: 14px;
      line-height: 1.9;
      font-style: normal;
    }

    .heart {
      position: fixed;
      bottom: -30px;
      pointer-events: none;
      font-size: 22px;
      animation: rise 5s linear forwards;
      z-index: 20;
    }

    .footer {
      margin-top: 35px;
      font-size: 12px;
      color: #b77b96;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0) rotate(-5deg); }
      50% { transform: translateY(-20px) rotate(5deg); }
    }

    @keyframes twinkle {
      0%, 100% { opacity: .25; transform: scale(.8); }
      50% { opacity: 1; transform: scale(1.2); }
    }

    @keyframes heartbeat {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.12); }
    }

    @keyframes appear {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes rise {
      0% { opacity: 0; transform: translateY(0) scale(.6) rotate(0); }
      15% { opacity: 1; }
      100% { opacity: 0; transform: translateY(-110vh) scale(1.2) rotate(30deg); }
    }

    @media (max-width: 480px) {
      .content { padding: 32px 15px 45px; }
      .welcome { padding: 25px 18px; }
      .welcome p { font-size: 17px; }
      .baby-card { padding: 10px; border-radius: 23px; }
      .photo { border-radius: 16px; }
      .balloon { transform: scale(.7); }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
      }
    }
  </style>
</head>

<body>
  <main class="page">
    <span class="sparkle">✦</span>
    <span class="sparkle">✧</span>
    <span class="sparkle">✦</span>
    <span class="sparkle">✧</span>

    <div class="balloon one"></div>
    <div class="balloon two"></div>
    <div class="balloon three"></div>

    <section class="content">
      <div class="tag">A little miracle has arrived</div>

      <h1>Welcome, Baby Fatima</h1>

      <p class="subtitle">Our tiny princess, our sweetest blessing 🎀</p>

      <div class="baby-card">
        <div class="photo" id="photo">
          <div class="placeholder">
            <div class="icon">🎀</div>
            <strong>Baby Fatima Tuz Zahra</strong>
            <p>Your first precious memories belong here</p>
          </div>
          <img id="babyImage" alt="Baby Fatima Tuz Zahra">
        </div>

        <div class="photo-label">Fatima Tuz Zahra</div>
        <div class="date">A little bundle of love from above ♡</div>
      </div>

      <div class="welcome">
        <h2>A Letter From Khala</h2>

        <p>
          You are my first and precious girl ever.
          I love youuu so muchhh, mera bacchawww,
          khala ki bebo. 💗
        </p>

        <div class="divider">♡ ✧ ♡</div>

        <p>
          May your life be filled with endless happiness,
          love, beautiful dreams and countless blessings.
          You are so loved, little princess.
        </p>

        <button class="button" id="surpriseButton">
          Open your little surprise 🎁
        </button>

        <div class="surprise" id="surprise">
          <h3>For My Bebo</h3>
          <p>
            Dear Fatima, you have made our world
            brighter with your tiny presence.
            Your Khala will always have a special
            place in her heart for you.
          </p>
          <div class="divider">♡</div>
          <p>
            With all my love,<br>
            Your Khala 💕
          </p>
        </div>
      </div>

      <div class="footer">
        Made with endless love by Khala for her precious bebo 🎀
      </div>
    </section>
  </main>

  <script>
    const surpriseButton = document.getElementById('surpriseButton');
    const surprise = document.getElementById('surprise');

    surpriseButton.addEventListener('click', () => {
      const isOpen = surprise.classList.toggle('show');

      surpriseButton.textContent = isOpen
        ? 'Close surprise 💗'
        : 'Open your little surprise 🎁';

      if (isOpen) {
        createHearts();
      }
    });

    function createHearts() {
      const symbols = ['♡', '♥', '✧', '🎀', '💗'];

      for (let i = 0; i < 18; i++) {
        const heart = document.createElement('span');
        heart.className = 'heart';
        heart.textContent = symbols[Math.floor(Math.random() * symbols.length)];
        heart.style.left = Math.random() * 100 + 'vw';
        heart.style.animationDuration = (3 + Math.random() * 3) + 's';
        heart.style.animationDelay = Math.random() * .8 + 's';
        document.body.appendChild(heart);

        heart.addEventListener('animationend', () => {
          heart.remove();
        });
      }
    }
  </script>
</body>
</html>

